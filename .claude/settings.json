{
  "permissions": {
    "allow": [
      "Bash(python*)",
      "Bash(pip*)",
      "Bash(npm*)",
      "Bash(npx*)",
      "Bash(node*)",
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(cat*)",
      "Bash(type*)",
      "Bash(cp*)",
      "Bash(mv*)",
      "Bash(rm*)",
      "Bash(mkdir*)",
      "Bash(dir*)",
      "Bash(set PYTHONUTF8*)",
      "mcp__puppeteer__puppeteer_evaluate",
      "mcp__puppeteer__puppeteer_screenshot",
      "mcp__puppeteer__puppeteer_fill",
      "mcp__puppeteer__puppeteer_navigate",
      "mcp__puppeteer__puppeteer_click",
      "mcp__puppeteer__puppeteer_select",
      "mcp__puppeteer__puppeteer_hover",
      "mcp__chrome-devtools__*"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -c \"[console]::beep(880,300)\"",
            "description": "Beep cuando Claude termina — saber cuándo mirar la pestaña"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -c \"[console]::beep(440,100)\"",
            "description": "Beep corto por cada comando Bash ejecutado"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "Write-Output '{\"systemMessage\":\"AUTO-REVIEW antes de declarar terminado: (1) Todas las herramientas disponibles usadas? (2) Sin duplicacion? (3) Pasos con rutas y lineas especificas? (4) Criterio de verificacion por paso? (5) Modelo correcto por tarea? (6) Que senalaria un revisor senior? — Si algo falta: mejorarlo ahora, no mencionarlo despues.\"}'",
            "shell": "powershell",
            "description": "Recordatorio auto-review despues de cada Write o Edit"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp"]
    }
  }
}
